<Window x:Class="Jetset.App.Views.FinishNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finish session"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <StackPanel Margin="16">
    <TextBlock Text="Optional note" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBox x:Name="NoteBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="6" />
    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
      <Button Content="Save session" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Click="Save_Click" IsDefault="True" />
      <Button Content="Cancel" Style="{DynamicResource SecondaryButton}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
