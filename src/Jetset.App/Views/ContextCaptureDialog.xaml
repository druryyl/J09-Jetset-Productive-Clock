<Window x:Class="Jetset.App.Views.ContextCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Jetset.App.Helpers"
        Title="{Binding WindowTitle}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Window.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <StackPanel Margin="16">
    <TextBlock Text="{Binding PromptTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding PromptMessage}"
               Foreground="{DynamicResource TextSecondaryBrush}"
               TextWrapping="Wrap"
               Margin="0,4,0,8" />
    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap">
      <Run Text="Task: " />
      <Run Text="{Binding TaskTitle, Mode=OneWay}" FontWeight="SemiBold" />
    </TextBlock>

    <TextBlock Text="Current status" Foreground="{DynamicResource TextSecondaryBrush}" />
    <TextBox x:Name="CurrentStatusBox"
             Text="{Binding CurrentStatus, UpdateSourceTrigger=PropertyChanged}"
             Margin="0,4,0,8" Padding="6"
             TextWrapping="Wrap" AcceptsReturn="True"
             MinHeight="36" VerticalScrollBarVisibility="Auto" />

    <TextBlock Text="Last progress" Foreground="{DynamicResource TextSecondaryBrush}" />
    <TextBox x:Name="LastProgressBox"
             Text="{Binding LastProgress, UpdateSourceTrigger=PropertyChanged}"
             Margin="0,4,0,8" Padding="6"
             TextWrapping="Wrap" AcceptsReturn="True"
             MinHeight="48" VerticalScrollBarVisibility="Auto" />

    <TextBlock Text="Next action" Foreground="{DynamicResource TextSecondaryBrush}" />
    <TextBox Text="{Binding NextAction, UpdateSourceTrigger=PropertyChanged}"
             Margin="0,4,0,8" Padding="6"
             TextWrapping="Wrap" AcceptsReturn="True"
             MinHeight="36" VerticalScrollBarVisibility="Auto" />

    <TextBlock Text="Blocker" Foreground="{DynamicResource TextSecondaryBrush}" />
    <TextBox Text="{Binding Blocker, UpdateSourceTrigger=PropertyChanged}"
             Margin="0,4,0,8" Padding="6"
             TextWrapping="Wrap" AcceptsReturn="True"
             MinHeight="36" VerticalScrollBarVisibility="Auto" />

    <TextBlock Text="Notes" Foreground="{DynamicResource TextSecondaryBrush}" />
    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
             Margin="0,4,0,8" Padding="6"
             TextWrapping="Wrap" AcceptsReturn="True"
             MinHeight="48" VerticalScrollBarVisibility="Auto" />

    <StackPanel Visibility="{Binding ShowSessionNote, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="Session note (optional)" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBox Text="{Binding SessionNote, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,4,0,8" Padding="6"
               Height="60" TextWrapping="Wrap" AcceptsReturn="True" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Right">
      <Button Content="Save" Style="{DynamicResource PrimaryButton}"
              Margin="0,0,8,0" Click="Save_Click" IsDefault="True" />
      <Button x:Name="SkipButton" Content="Skip" Style="{DynamicResource SecondaryButton}"
              Margin="0,0,8,0" Click="Skip_Click" />
      <Button x:Name="CancelButton" Content="Cancel" Style="{DynamicResource SecondaryButton}"
              Click="Cancel_Click"
              Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
  </StackPanel>
</Window>
