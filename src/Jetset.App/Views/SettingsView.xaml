<UserControl x:Class="Jetset.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Jetset.App.Views">
  <TabControl Margin="16">
    <TabItem Header="General">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
          <CheckBox Content="Always on top" IsChecked="{Binding General.AlwaysOnTop}" Margin="0,0,0,10" />
          <CheckBox Content="24-hour clock" IsChecked="{Binding General.Use24HourClock}" Margin="0,0,0,10" />
          <CheckBox Content="Show seconds" IsChecked="{Binding General.ShowSeconds}" Margin="0,0,0,10" />
          <CheckBox Content="Sound when countdown completes" IsChecked="{Binding General.SoundOnCountdownComplete}" Margin="0,0,0,10" />
          <CheckBox Content="Start with Windows" IsChecked="{Binding General.StartWithWindows}" Margin="0,0,0,10" />
          <CheckBox Content="Dark theme" IsChecked="{Binding General.UseDarkTheme}" Margin="0,0,0,16" />

          <CheckBox Content="Auto-pause when PC is idle" IsChecked="{Binding General.AutoPauseWhenIdle}" Margin="0,0,0,10" />
          <StackPanel Orientation="Horizontal" Margin="24,0,0,10"
                      IsEnabled="{Binding General.IdleOptionsEnabled}">
            <TextBlock Text="Idle timeout" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="72"
                      ItemsSource="{Binding General.IdleTimeoutOptions}"
                      SelectedItem="{Binding General.IdleTimeoutMinutes}" />
            <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
          <CheckBox Content="Auto-resume when activity returns"
                    IsChecked="{Binding General.AutoResumeAfterIdle}"
                    IsEnabled="{Binding General.IdleOptionsEnabled}"
                    Margin="24,0,0,16" />

          <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding General.Shortcuts}" Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="{Binding Shortcut}"
                             FontFamily="{DynamicResource MonospaceFont}"
                             FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Action}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal">
            <Button Content="Save" Command="{Binding General.SaveCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="Session history" Command="{Binding OpenHistoryCommand}" Style="{DynamicResource SecondaryButton}" />
          </StackPanel>
          <TextBlock Text="{Binding General.Message}" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Analytics">
      <views:AnalyticsView DataContext="{Binding Analytics}" />
    </TabItem>
  </TabControl>
</UserControl>
