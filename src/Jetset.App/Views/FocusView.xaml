<UserControl x:Class="Jetset.App.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Jetset.App.Helpers"
             x:Name="Root">
  <UserControl.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <helpers:IntEqualsConverter x:Key="IntEquals" />

    <DataTemplate x:Key="FocusTaskPickerItemTemplate">
      <Border Padding="8,6" Margin="0,0,0,6"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ProjectDisplay}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Start"
                    Command="{Binding DataContext.StartTaskCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    Style="{DynamicResource SecondaryButton}"
                    Margin="0,0,6,0" />
            <Button Content="Switch &amp; wait"
                    Command="{Binding DataContext.SwitchAndMarkWaitingCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    Style="{DynamicResource LinkButton}"
                    Visibility="{Binding DataContext.CanSwitchTasks, ElementName=Root, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
      <!-- Compact -->
      <StackPanel Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}">
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="Capture"
                  Command="{Binding QuickCaptureCommand}"
                  Style="{DynamicResource SecondaryButton}"
                  Margin="8,0,0,0" />
          <TextBox x:Name="CompactQuickCaptureTextBox"
                   Text="{Binding QuickCaptureTitle, UpdateSourceTrigger=PropertyChanged}"
                   Padding="6" VerticalAlignment="Center"
                   ToolTip="Quick capture to Inbox (Ctrl+Shift+C)" />
        </DockPanel>
        <TextBlock Text="{Binding CurrentTime}"
                   FontFamily="{DynamicResource DisplayFont}"
                   FontSize="28"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding CompactLine}"
                   Margin="0,8,0,0"
                   FontSize="14"
                   FontFamily="{DynamicResource MonospaceFont}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,12,0,0"
                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
          <Button Content="Pause" Command="{Binding PauseCommand}" Style="{DynamicResource SecondaryButton}"
                  Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
          <Button Content="Resume" Command="{Binding ResumeCommand}" Style="{DynamicResource PrimaryButton}"
                  Margin="0,0,8,0" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
          <Button Content="Finish" Command="{Binding FinishCommand}" Style="{DynamicResource SecondaryButton}" />
        </StackPanel>
        <Button Content="{Binding StartWorkButtonText}" Command="{Binding StartWorkCommand}" Style="{DynamicResource PrimaryButton}"
                HorizontalAlignment="Left" Margin="0,12,0,0"
                Visibility="{Binding ShowStartPanel, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
        <Button Content="Expand" Command="{Binding ToggleCompactCommand}" Style="{DynamicResource LinkButton}"
                HorizontalAlignment="Left" Margin="0,12,0,0" />
      </StackPanel>

      <!-- Expanded -->
      <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
        <Border Padding="8,6" Margin="0,0,0,12"
                Background="{DynamicResource AccentMutedBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                HorizontalAlignment="Left"
                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
          <TextBlock Text="Running task" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" />
        </Border>

        <DockPanel Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" Content="Capture to Inbox"
                  Command="{Binding QuickCaptureCommand}"
                  Style="{DynamicResource PrimaryButton}"
                  Margin="8,0,0,0" />
          <TextBox x:Name="QuickCaptureTextBox"
                   Text="{Binding QuickCaptureTitle, UpdateSourceTrigger=PropertyChanged}"
                   Padding="6" VerticalAlignment="Center"
                   ToolTip="Quick capture — does not switch your running task (Ctrl+Shift+C)" />
        </DockPanel>

        <!-- Idle clock -->
        <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding CurrentTime}" FontFamily="{DynamicResource DisplayFont}"
                     FontSize="48" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CurrentDate}" FontSize="16"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,16" />
          <Button Content="{Binding StartWorkButtonText}" Command="{Binding StartWorkCommand}" Style="{DynamicResource PrimaryButton}"
                  HorizontalAlignment="Left" FontSize="16"
                  Visibility="{Binding ShowStartPanel, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
        </StackPanel>

        <!-- Active session -->
        <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
          <TextBlock Text="{Binding CurrentTime}" FontFamily="{DynamicResource DisplayFont}"
                     FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding TaskName}" FontSize="18" FontWeight="SemiBold"
                     Margin="0,16,0,4" TextWrapping="Wrap" />
          <TextBlock Text="{Binding TimerDisplay}" FontFamily="{DynamicResource MonospaceFont}"
                     FontSize="36" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ModeText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,4,0,0"
                     Foreground="{DynamicResource PausedBrush}"
                     Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
          <Border Margin="0,12,0,0" Padding="12"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  Visibility="{Binding HasProjectContext, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="{Binding ProjectName, StringFormat=Project: {0}}"
                         FontWeight="SemiBold" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Project context" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,4" />
              <TextBlock Text="{Binding ProjectContextText}" TextWrapping="Wrap" FontSize="13"
                         Visibility="{Binding HasProjectContextText, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="No context yet."
                         FontSize="12" FontStyle="Italic"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Visibility="{Binding HasProjectContextText, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
              <Button Content="Edit on project" Command="{Binding EditProjectContextCommand}"
                      Style="{DynamicResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Pause" Command="{Binding PauseCommand}" Style="{DynamicResource SecondaryButton}"
                    Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            <Button Content="Resume" Command="{Binding ResumeCommand}" Style="{DynamicResource PrimaryButton}"
                    Margin="0,0,8,0" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
            <Button Content="Finish" Command="{Binding FinishCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" />
            <Button Content="{Binding StartWorkButtonText}" Command="{Binding StartWorkCommand}" Style="{DynamicResource LinkButton}"
                    Visibility="{Binding ShowStartPanel, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
          </StackPanel>
        </StackPanel>

        <!-- Ready tasks -->
        <StackPanel Margin="0,16,0,0">
          <TextBlock Text="Ready" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
          <TextBlock Text="No ready tasks."
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="12"
                     Visibility="{Binding HasReadyTasks, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
          <ItemsControl ItemsSource="{Binding ReadyTasks}"
                        ItemTemplate="{StaticResource FocusTaskPickerItemTemplate}"
                        Visibility="{Binding HasReadyTasks, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Waiting tasks -->
        <StackPanel Margin="0,12,0,0">
          <TextBlock Text="Waiting" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
          <TextBlock Text="No waiting tasks."
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="12"
                     Visibility="{Binding HasWaitingTasks, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
          <ItemsControl ItemsSource="{Binding WaitingTasks}"
                        ItemTemplate="{StaticResource FocusTaskPickerItemTemplate}"
                        Visibility="{Binding HasWaitingTasks, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Timer options panel -->
        <Border Margin="0,16,0,0" Padding="12"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding ShowStartPanel, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Timer options" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
            <TextBlock Text="Task" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding StartSession.AvailableTasks}"
                      SelectedValue="{Binding StartSession.SelectedTaskId}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="Title"
                      Margin="0,4,0,10" Padding="4" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton Content="Stopwatch" IsChecked="{Binding StartSession.IsStopwatch}"
                           Margin="0,0,16,0" GroupName="Mode" />
              <RadioButton Content="Countdown" IsChecked="{Binding StartSession.IsCountdown}"
                           GroupName="Mode" />
            </StackPanel>

            <StackPanel Visibility="{Binding StartSession.IsCountdown, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Duration" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
              <WrapPanel>
                <RadioButton Content="5m" GroupName="Preset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.SelectedPresetMinutes, Converter={StaticResource IntEquals}, ConverterParameter=5}" />
                <RadioButton Content="15m" GroupName="Preset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.SelectedPresetMinutes, Converter={StaticResource IntEquals}, ConverterParameter=15}" />
                <RadioButton Content="25m" GroupName="Preset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.SelectedPresetMinutes, Converter={StaticResource IntEquals}, ConverterParameter=25}" />
                <RadioButton Content="45m" GroupName="Preset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.SelectedPresetMinutes, Converter={StaticResource IntEquals}, ConverterParameter=45}" />
                <RadioButton Content="60m" GroupName="Preset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.SelectedPresetMinutes, Converter={StaticResource IntEquals}, ConverterParameter=60}" />
                <RadioButton Content="Custom" GroupName="Preset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.UseCustomDuration}" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal"
                          Visibility="{Binding StartSession.UseCustomDuration, Converter={StaticResource BoolToVis}}">
                <TextBox Width="64" Padding="6"
                         Text="{Binding StartSession.CustomMinutes, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Start" Command="{Binding ConfirmStartCommand}"
                      Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" />
              <Button Content="Cancel" Command="{Binding CancelStartCommand}"
                      Style="{DynamicResource SecondaryButton}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding TodayTotalText}" FontSize="14" Margin="0,20,0,0" />
        <Border Margin="0,8,0,0" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left"
                Background="{DynamicResource AccentMutedBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding HasStreak, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding StreakText}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" />
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="History" Command="{Binding OpenHistoryCommand}"
                  Style="{DynamicResource LinkButton}" Margin="0,0,16,0" />
          <Button Content="Settings" Command="{Binding OpenSettingsCommand}"
                  Style="{DynamicResource LinkButton}" Margin="0,0,16,0" />
          <Button Content="Compact" Command="{Binding ToggleCompactCommand}"
                  Style="{DynamicResource LinkButton}" />
        </StackPanel>
        <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerBrush}"
                   Margin="0,8,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
