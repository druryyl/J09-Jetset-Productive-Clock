<Window x:Class="Jetset.App.Views.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover session"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <StackPanel Margin="16">
    <TextBlock Text="A work session was active when Jetset stopped."
               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
      <Run Text="Task: " /><Run Text="{Binding TaskSummary, Mode=OneWay}" FontWeight="SemiBold" />
    </TextBlock>
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
      <Run Text="Started: " /><Run Text="{Binding StartedSummary, Mode=OneWay}" />
    </TextBlock>
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
      <Run Text="Last known activity: " /><Run Text="{Binding LastKnownSummary, Mode=OneWay}" />
    </TextBlock>
    <TextBlock Text="{Binding LimitationText}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
    <StackPanel>
      <Button Content="Continue" Click="Continue_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,0,8" />
      <Button Content="Finish at last known activity" Click="Finish_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8" />
      <Button Content="Discard" Click="Discard_Click" Style="{DynamicResource SecondaryButton}" />
    </StackPanel>
  </StackPanel>
</Window>
