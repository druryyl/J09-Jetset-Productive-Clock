<UserControl x:Class="Jetset.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Jetset.App.Helpers"
             xmlns:vm="clr-namespace:Jetset.App.ViewModels">
  <UserControl.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <DataTemplate x:Key="TaskStatusBadgeTemplate">
      <Border Padding="6,2" CornerRadius="3" BorderThickness="1" HorizontalAlignment="Left">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Status}" Value="Inbox">
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Waiting">
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PausedBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding StatusText}" FontSize="11">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Inbox">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                  <Setter Property="Foreground" Value="{DynamicResource PausedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TaskOriginBadgeTemplate">
      <Border Padding="6,2" CornerRadius="3" BorderThickness="1" HorizontalAlignment="Left"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource TextSecondaryBrush}">
        <TextBlock Text="{Binding OriginText}" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
              Style="{DynamicResource SecondaryButton}" />
      <TextBlock Text="Tasks" FontSize="20" FontWeight="SemiBold"
                 FontFamily="{DynamicResource DisplayFont}" VerticalAlignment="Center" />
    </DockPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Command="{Binding SetStatusFilterCommand}"
              CommandParameter="{x:Static vm:StatusFilterMode.All}" Margin="0,0,6,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Content" Value="All" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsAllStatusesFilterSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="Inbox" Command="{Binding SetStatusFilterCommand}"
              CommandParameter="{x:Static vm:StatusFilterMode.Inbox}" Margin="0,0,6,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsInboxFilterSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="Ready" Command="{Binding SetStatusFilterCommand}"
              CommandParameter="{x:Static vm:StatusFilterMode.Ready}" Margin="0,0,6,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsReadyFilterSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="Waiting" Command="{Binding SetStatusFilterCommand}"
              CommandParameter="{x:Static vm:StatusFilterMode.Waiting}" Margin="0,0,6,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsWaitingFilterSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="Done" Command="{Binding SetStatusFilterCommand}"
              CommandParameter="{x:Static vm:StatusFilterMode.Done}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsDoneFilterSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </StackPanel>

    <DockPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
    </DockPanel>

    <DockPanel Grid.Row="3" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="Project" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
      <ComboBox ItemsSource="{Binding FilterOptions}"
                SelectedItem="{Binding SelectedFilter}"
                DisplayMemberPath="DisplayName"
                Padding="4" />
    </DockPanel>

    <DockPanel Grid.Row="4" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="Status" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
      <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                SelectedItem="{Binding SelectedStatusFilter}"
                DisplayMemberPath="DisplayName"
                Padding="4" />
    </DockPanel>

    <DockPanel Grid.Row="5" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="Origin" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
      <ComboBox ItemsSource="{Binding OriginFilterOptions}"
                SelectedItem="{Binding SelectedOriginFilter}"
                DisplayMemberPath="DisplayName"
                Padding="4" />
    </DockPanel>

    <DockPanel Grid.Row="6" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Capture to Inbox" Command="{Binding AddTaskCommand}"
              Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0" />
      <TextBox Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}"
               Padding="6" VerticalAlignment="Center"
               ToolTip="Quick capture — does not switch your running task" />
    </DockPanel>

    <Grid Grid.Row="7">
      <TextBlock Text="No tasks yet. Add one above."
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

      <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                 BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackgroundBrush}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TaskStatusBadgeTemplate}"
                                  Margin="0,4,0,0" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TaskOriginBadgeTemplate}"
                                  Margin="0,4,0,0" />
                <TextBlock Text="{Binding ProjectDisplay}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Content="Start work"
                          Command="{Binding DataContext.StartWorkForTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding}"
                          Style="{DynamicResource SecondaryButton}"
                          Margin="0,0,6,0"
                          Visibility="{Binding CanStartWork, Converter={StaticResource BoolToVis}}" />
                  <Button Content="Resume"
                          Command="{Binding DataContext.ResumeWorkForTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding}"
                          Style="{DynamicResource PrimaryButton}"
                          Margin="0,0,6,0"
                          Visibility="{Binding CanResumeWork, Converter={StaticResource BoolToVis}}" />
                  <Button Content="Switch &amp; wait"
                          Command="{Binding DataContext.SwitchAndMarkWaitingForTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding}"
                          Style="{DynamicResource LinkButton}"
                          Margin="0,0,6,0"
                          Visibility="{Binding ShowSwitchActions, Converter={StaticResource BoolToVis}}" />
                  <TextBlock Text="Active" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource AccentBrush}"
                             Visibility="{Binding IsWorkActive, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Margin="12,0,0,0" Padding="12"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Task detail" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock Text="Title" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,4,0,8" Padding="4" />
              <TextBlock Text="Status" Foreground="{DynamicResource TextSecondaryBrush}" />
              <ComboBox ItemsSource="{Binding EditableStatusOptions}"
                        SelectedItem="{Binding Selected.Status}"
                        Margin="0,4,0,8" />
              <Button Content="Reopen"
                      Command="{Binding ReopenCommand}"
                      Style="{DynamicResource SecondaryButton}"
                      Margin="0,0,0,8"
                      Visibility="{Binding CanReopenSelected, Converter={StaticResource BoolToVis}}" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Start work"
                        Command="{Binding StartWorkCommand}"
                        Style="{DynamicResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Visibility="{Binding CanStartWorkSelected, Converter={StaticResource BoolToVis}}" />
                <Button Content="Resume"
                        Command="{Binding ResumeWorkCommand}"
                        Style="{DynamicResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Visibility="{Binding CanResumeWorkSelected, Converter={StaticResource BoolToVis}}" />
                <Button Content="Switch &amp; wait"
                        Command="{Binding SwitchAndMarkWaitingCommand}"
                        Style="{DynamicResource LinkButton}"
                        Margin="0,0,8,0"
                        Visibility="{Binding CanSwitchWorkSelected, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="Currently active in Focus"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding Selected.IsWorkActive, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
              <TextBlock Text="Project" Foreground="{DynamicResource TextSecondaryBrush}" />
              <ComboBox ItemsSource="{Binding ProjectOptions}"
                        SelectedItem="{Binding SelectedProjectOption}"
                        DisplayMemberPath="DisplayName"
                        Margin="0,4,0,8" />
              <Button Content="View project context"
                      Command="{Binding ViewProjectContextCommand}"
                      Style="{DynamicResource LinkButton}"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,8"
                      Visibility="{Binding Selected.HasProject, Converter={StaticResource BoolToVis}}" />

              <TextBlock Text="Total focus time" FontWeight="SemiBold" Margin="0,8,0,4"
                         Visibility="{Binding HasFocusTime, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="{Binding FocusTimeText}"
                         Foreground="{DynamicResource AccentBrush}"
                         Margin="0,0,0,8"
                         Visibility="{Binding HasFocusTime, Converter={StaticResource BoolToVis}}" />

              <TextBlock Text="Notes" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding Selected.Notes, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,4,0,8" Padding="4"
                       Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" />

              <Button Content="Save changes" Command="{Binding SaveCommand}"
                      Style="{DynamicResource PrimaryButton}" />
              <Button Content="Delete task" Command="{Binding DeleteCommand}" Margin="0,8,0,0"
                      Style="{DynamicResource SecondaryButton}" />
              <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="8" Text="{Binding Message}" Margin="0,12,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"
               Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
  </Grid>
</UserControl>
