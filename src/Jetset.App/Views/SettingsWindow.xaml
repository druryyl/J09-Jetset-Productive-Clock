<Window x:Class="Jetset.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="360"
        Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
               FontFamily="{DynamicResource DisplayFont}" Margin="0,0,0,16" />

    <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,10" />
    <CheckBox Content="24-hour clock" IsChecked="{Binding Use24HourClock}" Margin="0,0,0,10" />
    <CheckBox Content="Show seconds" IsChecked="{Binding ShowSeconds}" Margin="0,0,0,10" />
    <CheckBox Content="Sound when countdown completes" IsChecked="{Binding SoundOnCountdownComplete}" Margin="0,0,0,10" />
    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10" />
    <CheckBox Content="Dark theme" IsChecked="{Binding UseDarkTheme}" Margin="0,0,0,16" />

    <StackPanel Orientation="Horizontal">
      <Button Content="Save" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" />
      <Button Content="Close" Style="{DynamicResource SecondaryButton}" IsCancel="True" Click="Close_Click" />
    </StackPanel>
    <TextBlock Text="{Binding Message}" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
  </StackPanel>
</Window>
