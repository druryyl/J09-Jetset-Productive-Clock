<UserControl x:Class="Jetset.App.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Jetset.App.Helpers">
  <UserControl.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="HeatmapCellStyle" TargetType="Border">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource HeatmapLevel0Brush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IntensityLevel}" Value="1">
          <Setter Property="Background" Value="{DynamicResource HeatmapLevel1Brush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IntensityLevel}" Value="2">
          <Setter Property="Background" Value="{DynamicResource HeatmapLevel2Brush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IntensityLevel}" Value="3">
          <Setter Property="Background" Value="{DynamicResource HeatmapLevel3Brush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IntensityLevel}" Value="4">
          <Setter Property="Background" Value="{DynamicResource HeatmapLevel4Brush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsVisible}" Value="False">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Padding="10,6" Margin="0,0,8,0" CornerRadius="4"
                  Background="{DynamicResource AccentMutedBrush}"
                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Streak" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
              <TextBlock Text="{Binding CurrentStreakText}" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Padding="10,6" Margin="0,0,8,0" CornerRadius="4"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding LongestStreakText}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
          <Button Content="Refresh" Command="{Binding RefreshCommand}"
                  Style="{DynamicResource SecondaryButton}" />
        </StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                   FontFamily="{DynamicResource DisplayFont}" VerticalAlignment="Center" />
      </DockPanel>

      <Border Grid.Row="1" Padding="16" Margin="0,0,0,16"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <TextBlock Text="Activity" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding HeatmapRangeText}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
          </DockPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top">
              <TextBlock Text="Mon" Height="14" Margin="0,1" FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock Height="14" Margin="0,1" />
              <TextBlock Text="Wed" Height="14" Margin="0,1" FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock Height="14" Margin="0,1" />
              <TextBlock Text="Fri" Height="14" Margin="0,1" FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock Height="14" Margin="0,1" />
              <TextBlock Height="14" Margin="0,1" />
            </StackPanel>

            <ItemsControl Grid.Column="1" ItemsSource="{Binding HeatmapWeeks}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource HeatmapCellStyle}"
                                ToolTip="{Binding TooltipText}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <DockPanel Margin="0,12,0,0">
            <TextBlock Text="Less" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Border Width="12" Height="12" Margin="1" CornerRadius="2"
                      Background="{DynamicResource HeatmapLevel0Brush}" />
              <Border Width="12" Height="12" Margin="1" CornerRadius="2"
                      Background="{DynamicResource HeatmapLevel1Brush}" />
              <Border Width="12" Height="12" Margin="1" CornerRadius="2"
                      Background="{DynamicResource HeatmapLevel2Brush}" />
              <Border Width="12" Height="12" Margin="1" CornerRadius="2"
                      Background="{DynamicResource HeatmapLevel3Brush}" />
              <Border Width="12" Height="12" Margin="1" CornerRadius="2"
                      Background="{DynamicResource HeatmapLevel4Brush}" />
              <TextBlock Text="More" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <DockPanel Grid.Row="2" Margin="0,0,0,16">
        <TextBlock DockPanel.Dock="Left" Text="Date" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
        <DatePicker SelectedDate="{Binding SelectedDate}" Padding="4" />
      </DockPanel>

      <Border Grid.Row="3" Padding="16" Margin="0,0,0,16"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{Binding DailyFocusDateText}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBlock Text="Focus time" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding TotalFocusTimeText}" FontSize="32" FontWeight="SemiBold"
                     FontFamily="{DynamicResource DisplayFont}" Margin="0,4,0,8" />
          <TextBlock Text="{Binding SessionSummaryText}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="4">
        <TextBlock Text="No focus time recorded for this day."
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Visibility="{Binding HasTaskBreakdown, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

        <StackPanel Visibility="{Binding HasTaskBreakdown, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="By task" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ListBox ItemsSource="{Binding TaskBreakdown}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   Background="{DynamicResource PanelBackgroundBrush}"
                   MaxHeight="320">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TaskTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SessionCountText}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding FocusTimeText}" FontWeight="SemiBold"
                             VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
