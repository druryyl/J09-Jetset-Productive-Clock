<Window x:Class="Jetset.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Jetset.App.Helpers"
        Title="History"
        Width="640"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Window.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
              Style="{DynamicResource SecondaryButton}" />
      <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="SemiBold"
                 FontFamily="{DynamicResource DisplayFont}" VerticalAlignment="Center" />
    </DockPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
      <Button DockPanel.Dock="Left" Content="◀" Width="36" Margin="0,0,4,0"
              Command="{Binding PreviousDayCommand}" Style="{DynamicResource SecondaryButton}"
              ToolTip="Previous day" />
      <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding SelectedDate}"
                  Width="140" VerticalAlignment="Center" Margin="0,0,4,0" />
      <Button DockPanel.Dock="Left" Content="▶" Width="36" Margin="0,0,8,0"
              Command="{Binding NextDayCommand}" Style="{DynamicResource SecondaryButton}"
              ToolTip="Next day" />
      <Button DockPanel.Dock="Left" Content="Today" Command="{Binding GoToTodayCommand}"
              Style="{DynamicResource SecondaryButton}" />
    </DockPanel>

    <Grid Grid.Row="2">
      <TextBlock Text="{Binding Message}"
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

      <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                 BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackgroundBrush}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4">
                <TextBlock>
                  <Run Text="{Binding TimeRange, Mode=OneWay}" />
                  <Run Text="  " />
                  <Run Text="{Binding TaskName, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text="  " />
                  <Run Text="{Binding DurationText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                  <Run Text="{Binding ModeText, Mode=OneWay}" />
                  <Run Text=" · " />
                  <Run Text="{Binding StatusText, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Margin="12,0,0,0" Padding="12"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Edit session" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Task name" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding Selected.TaskName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="4" />
            <TextBlock Text="Note" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding Selected.Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="4"
                     Height="60" TextWrapping="Wrap" AcceptsReturn="True" />
            <TextBlock Text="Start (local)" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding EditStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="4" />
            <TextBlock Text="Finish (local)" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding EditFinish, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="4" />
            <TextBlock Text="Active duration (minutes)" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding EditDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="4" />
            <Button Content="Save changes" Command="{Binding SaveEditCommand}" Style="{DynamicResource PrimaryButton}" />
            <Button Content="Delete session" Command="{Binding DeleteSessionCommand}" Margin="0,8,0,0"
                    Style="{DynamicResource SecondaryButton}" />
            <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Button Grid.Row="3" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0"
            Style="{DynamicResource SecondaryButton}" IsCancel="True" Click="Close_Click" />
  </Grid>
</Window>
