<Window x:Class="Jetset.App.Views.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Jetset.App.Helpers"
        Title="Tasks"
        Width="720"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Window.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <DataTemplate x:Key="TaskStatusBadgeTemplate">
      <Border Padding="6,2" CornerRadius="3" BorderThickness="1" HorizontalAlignment="Left">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Status}" Value="Blocked">
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PausedBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding StatusText}" FontSize="11">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Blocked">
                  <Setter Property="Foreground" Value="{DynamicResource PausedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
              Style="{DynamicResource SecondaryButton}" />
      <TextBlock Text="Tasks" FontSize="20" FontWeight="SemiBold"
                 FontFamily="{DynamicResource DisplayFont}" VerticalAlignment="Center" />
    </DockPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
    </DockPanel>

    <DockPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="Project" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
      <ComboBox ItemsSource="{Binding FilterOptions}"
                SelectedItem="{Binding SelectedFilter}"
                DisplayMemberPath="DisplayName"
                Padding="4" />
    </DockPanel>

    <DockPanel Grid.Row="3" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="Status" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
      <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                SelectedItem="{Binding SelectedStatusFilter}"
                DisplayMemberPath="DisplayName"
                Padding="4" />
    </DockPanel>

    <DockPanel Grid.Row="4" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Add Task" Command="{Binding AddTaskCommand}"
              Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0" />
      <TextBox Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}"
               Padding="6" VerticalAlignment="Center" />
    </DockPanel>

    <Grid Grid.Row="5">
      <TextBlock Text="No tasks yet. Add one above."
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

      <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                 BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackgroundBrush}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TaskStatusBadgeTemplate}"
                                  Margin="0,4,0,0" />
                <TextBlock Text="{Binding ProjectDisplay}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Margin="12,0,0,0" Padding="12"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Task detail" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Title" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,4,0,8" Padding="4" />
            <TextBlock Text="Status" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding Selected.Status}"
                      Margin="0,4,0,8" />
            <Button Content="Reopen"
                    Command="{Binding ReopenCommand}"
                    Style="{DynamicResource SecondaryButton}"
                    Margin="0,0,0,8"
                    Visibility="{Binding CanReopenSelected, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="Project" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding ProjectOptions}"
                      SelectedItem="{Binding SelectedProjectOption}"
                      DisplayMemberPath="DisplayName"
                      Margin="0,4,0,8" />
            <TextBlock Text="Milestone" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding MilestoneOptions}"
                      SelectedItem="{Binding SelectedMilestoneOption}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding CanAssignMilestone}"
                      Margin="0,4,0,8" />
            <TextBlock Text="Notes" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding Selected.Notes, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,4,0,8" Padding="4"
                     Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />
            <Button Content="Save changes" Command="{Binding SaveCommand}"
                    Style="{DynamicResource PrimaryButton}" />
            <Button Content="Delete task" Command="{Binding DeleteCommand}" Margin="0,8,0,0"
                    Style="{DynamicResource SecondaryButton}" />
            <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <DockPanel Grid.Row="6" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Close"
              Style="{DynamicResource SecondaryButton}" IsCancel="True" Click="Close_Click" />
      <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
    </DockPanel>
  </Grid>
</Window>
