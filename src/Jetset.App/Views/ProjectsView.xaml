<UserControl x:Class="Jetset.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Jetset.App.Helpers">
  <UserControl.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <DataTemplate x:Key="TaskStatusBadgeTemplate">
      <Border Padding="6,2" CornerRadius="3" BorderThickness="1" HorizontalAlignment="Left">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Status}" Value="Blocked">
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PausedBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding StatusText}" FontSize="11">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Blocked">
                  <Setter Property="Foreground" Value="{DynamicResource PausedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>
    </DataTemplate>

    <Style x:Key="MomentumBarTrackStyle" TargetType="Border">
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource HeatmapLevel0Brush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="MomentumWeekTemplate">
      <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="172" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding WeekLabel}" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MomentumBarTrackStyle}">
          <Border Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" CornerRadius="2"
                  Height="10" Width="{Binding FocusBarWidth}" />
        </Border>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding FocusTimeText}" FontSize="11"
                   Margin="8,0,0,0" VerticalAlignment="Center" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tasks" FontSize="10"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                   VerticalAlignment="Center" />
        <Border Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource MomentumBarTrackStyle}">
          <Border Background="{DynamicResource PausedBrush}" HorizontalAlignment="Left" CornerRadius="2"
                  Height="10" Width="{Binding CompletionBarWidth}" />
        </Border>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CompletionText}" FontSize="10"
                   Margin="8,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
              Style="{DynamicResource SecondaryButton}" />
      <TextBlock Text="Projects" FontSize="20" FontWeight="SemiBold"
                 FontFamily="{DynamicResource DisplayFont}" VerticalAlignment="Center" />
    </DockPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Add Project" Command="{Binding AddProjectCommand}"
              Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0" />
      <TextBox Text="{Binding QuickAddName, UpdateSourceTrigger=PropertyChanged}"
               Padding="6" VerticalAlignment="Center" />
    </DockPanel>

    <Grid Grid.Row="2">
      <TextBlock Text="No projects yet. Add one above."
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

      <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                 BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackgroundBrush}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TaskCountText}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding DeadlineText}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasDeadline, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Margin="12,0,0,0" Padding="12"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Project detail" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock Text="Name" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,4,0,8" Padding="4" />

              <CheckBox Content="Set deadline" IsChecked="{Binding Selected.HasDeadline}"
                        Margin="0,0,0,4" />
              <DatePicker SelectedDate="{Binding Selected.DeadlineDate}"
                          Margin="0,0,0,8"
                          IsEnabled="{Binding Selected.HasDeadline}"
                          Visibility="{Binding Selected.HasDeadline, Converter={StaticResource BoolToVis}}" />

              <TextBlock Text="Momentum" FontWeight="SemiBold" Margin="0,8,0,4" />
              <TextBlock Text="{Binding MomentumRangeText}" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
              <TextBlock Text="{Binding MomentumSummaryText}" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding MomentumWeeks}"
                            ItemTemplate="{StaticResource MomentumWeekTemplate}"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasMomentumWeeks, Converter={StaticResource BoolToVis}}" />

              <TextBlock Text="Milestones" FontWeight="SemiBold" Margin="0,4,0,4" />
              <TextBlock Text="No milestones yet."
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,0,0,8"
                         Visibility="{Binding HasMilestones, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
              <ListBox ItemsSource="{Binding Milestones}"
                       SelectedItem="{Binding SelectedMilestone}"
                       Margin="0,0,0,8"
                       MaxHeight="140"
                       BorderBrush="{DynamicResource BorderBrush}"
                       Background="{DynamicResource WindowBackgroundBrush}"
                       Visibility="{Binding HasMilestones, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="2">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Visibility="{Binding HasMilestoneSelection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Milestone name" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Text="{Binding SelectedMilestone.Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,8" Padding="4" />
                <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Content="Down" Command="{Binding MoveMilestoneDownCommand}"
                          Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" />
                  <Button DockPanel.Dock="Right" Content="Up" Command="{Binding MoveMilestoneUpCommand}"
                          Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" />
                  <Button Content="Save milestone" Command="{Binding SaveMilestoneCommand}"
                          Style="{DynamicResource SecondaryButton}" />
                </DockPanel>
                <Button Content="Delete milestone" Command="{Binding DeleteMilestoneCommand}"
                        Margin="0,0,0,8" Style="{DynamicResource SecondaryButton}" />
              </StackPanel>

              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddMilestoneCommand}"
                        Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" />
                <TextBox Text="{Binding QuickAddMilestoneName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4" VerticalAlignment="Center" />
              </DockPanel>

              <TextBlock Text="Tasks" FontWeight="SemiBold" Margin="0,4,0,4" />
              <TextBlock Text="No tasks in this project."
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,0,0,8"
                         Visibility="{Binding HasProjectTasks, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
              <ItemsControl ItemsSource="{Binding ProjectTasks}"
                            Visibility="{Binding HasProjectTasks, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TaskStatusBadgeTemplate}"
                                        Margin="0,2,0,0" />
                      <TextBlock Text="{Binding MilestoneDisplay}" FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Visibility="{Binding HasMilestone, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Text="{Binding CurrentStatus, StringFormat=Status: {0}}"
                                 FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Visibility="{Binding HasCurrentStatusDisplay, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Text="{Binding LastProgress, StringFormat=Progress: {0}}"
                                 FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Visibility="{Binding HasLastProgressDisplay, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Text="{Binding NextAction, StringFormat=Next: {0}}"
                                 FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Visibility="{Binding HasNextActionDisplay, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Text="{Binding BlockerDisplay, StringFormat=Blocker: {0}}"
                                 FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Foreground="{DynamicResource PausedBrush}"
                                 Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVis}}" />
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Start work"
                                Command="{Binding DataContext.StartWorkForTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{DynamicResource SecondaryButton}"
                                Margin="0,0,6,0"
                                Visibility="{Binding CanStartWork, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Resume"
                                Command="{Binding DataContext.ResumeWorkForTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{DynamicResource PrimaryButton}"
                                Margin="0,0,6,0"
                                Visibility="{Binding CanResumeWork, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Active" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding IsWorkActive, Converter={StaticResource BoolToVis}}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <DockPanel Margin="0,8,0,8">
                <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddTaskCommand}"
                        Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" />
                <TextBox Text="{Binding QuickAddTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4" VerticalAlignment="Center" />
              </DockPanel>

              <Button Content="Save changes" Command="{Binding SaveCommand}"
                      Style="{DynamicResource PrimaryButton}" />
              <Button Content="Delete project" Command="{Binding DeleteCommand}" Margin="0,8,0,0"
                      Style="{DynamicResource SecondaryButton}" />
              <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="3" Text="{Binding Message}" Margin="0,12,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"
               Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
  </Grid>
</UserControl>
