<Window x:Class="Jetset.App.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:helpers="clr-namespace:Jetset.App.Helpers"

        xmlns:vm="clr-namespace:Jetset.App.ViewModels"

        xmlns:views="clr-namespace:Jetset.App.Views"

        Title="Jetset"

        Width="720"

        Height="560"

        MinWidth="280"

        MinHeight="160"

        WindowStartupLocation="Manual"

        Topmost="{Binding Focus.AlwaysOnTop}"

        Background="{DynamicResource WindowBackgroundBrush}"

        Foreground="{DynamicResource TextPrimaryBrush}"

        KeyDown="Window_KeyDown">

  <Window.Resources>

    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />

    <DataTemplate DataType="{x:Type vm:WorkTreeViewModel}">

      <views:WorkTreeView />

    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsAreaViewModel}">

      <views:SettingsView />

    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FocusViewModel}">

      <views:CompactOverlayView />

    </DataTemplate>

  </Window.Resources>



  <Grid>

    <Grid.RowDefinitions>

      <RowDefinition Height="Auto" />

      <RowDefinition Height="*" />

    </Grid.RowDefinitions>



    <Border Grid.Row="0"

            Padding="12,8"

            BorderBrush="{DynamicResource BorderBrush}"

            BorderThickness="0,0,0,1"

            Background="{DynamicResource PanelBackgroundBrush}"

            Visibility="{Binding ShowNavigation, Converter={StaticResource BoolToVis}}">

      <Grid>

        <Grid.RowDefinitions>

          <RowDefinition Height="Auto" />

          <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">

          <TextBox DockPanel.Dock="Right"

                   Text="{Binding Search.SearchText, UpdateSourceTrigger=PropertyChanged}"

                   Width="180"

                   Margin="12,0,0,0"

                   Padding="6,4"

                   VerticalAlignment="Center"

                   ToolTip="Search tasks and context" />

          <StackPanel Orientation="Horizontal">

            <Button Content="Work Tree" Command="{Binding NavigateWorkTreeCommand}">

              <Button.Style>

                <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">

                  <Style.Triggers>

                    <DataTrigger Binding="{Binding IsWorkTreeSelected}" Value="True">

                      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />

                      <Setter Property="FontWeight" Value="SemiBold" />

                    </DataTrigger>

                  </Style.Triggers>

                </Style>

              </Button.Style>

            </Button>

            <Button Content="Settings" Command="{Binding NavigateSettingsCommand}">

              <Button.Style>

                <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">

                  <Style.Triggers>

                    <DataTrigger Binding="{Binding IsSettingsSelected}" Value="True">

                      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />

                      <Setter Property="FontWeight" Value="SemiBold" />

                    </DataTrigger>

                  </Style.Triggers>

                </Style>

              </Button.Style>

            </Button>

          </StackPanel>

        </DockPanel>

        <Border Grid.Row="1"

                Margin="0,8,0,0"

                Padding="8"

                MaxHeight="280"

                Background="{DynamicResource WindowBackgroundBrush}"

                BorderBrush="{DynamicResource BorderBrush}"

                BorderThickness="1"

                Visibility="{Binding Search.ShowResults, Converter={StaticResource BoolToVis}}">

          <Grid>

            <TextBlock Text="No matching tasks."

                       VerticalAlignment="Center"

                       HorizontalAlignment="Center"

                       Foreground="{DynamicResource TextSecondaryBrush}"

                       Visibility="{Binding Search.HasResults, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"

                          Visibility="{Binding Search.HasResults, Converter={StaticResource BoolToVis}}">

              <ItemsControl ItemsSource="{Binding Search.Results}">

                <ItemsControl.ItemTemplate>

                  <DataTemplate>

                    <Border Padding="8,6" Margin="0,0,0,6"

                            Background="{DynamicResource PanelBackgroundBrush}"

                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

                      <Grid>

                        <Grid.ColumnDefinitions>

                          <ColumnDefinition Width="*" />

                          <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">

                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />

                          <TextBlock Text="{Binding SearchSubtitle}" FontSize="11"

                                     Foreground="{DynamicResource TextSecondaryBrush}" />

                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                          <Button Content="Start"

                                  Command="{Binding DataContext.Search.StartWorkForTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                  CommandParameter="{Binding}"

                                  Style="{DynamicResource SecondaryButton}"

                                  Margin="0,0,6,0"

                                  Visibility="{Binding CanStartWork, Converter={StaticResource BoolToVis}}" />

                          <Button Content="Resume"

                                  Command="{Binding DataContext.Search.ResumeWorkForTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                  CommandParameter="{Binding}"

                                  Style="{DynamicResource PrimaryButton}"

                                  Visibility="{Binding CanResumeWork, Converter={StaticResource BoolToVis}}" />

                          <TextBlock Text="Active" FontSize="11" VerticalAlignment="Center"

                                     Foreground="{DynamicResource AccentBrush}"

                                     Visibility="{Binding IsWorkActive, Converter={StaticResource BoolToVis}}" />

                        </StackPanel>

                      </Grid>

                    </Border>

                  </DataTemplate>

                </ItemsControl.ItemTemplate>

              </ItemsControl>

            </ScrollViewer>

          </Grid>

        </Border>

      </Grid>

    </Border>



    <Grid Grid.Row="1">

      <ContentControl Content="{Binding CurrentViewModel}"

                      HorizontalContentAlignment="Stretch"

                      VerticalContentAlignment="Stretch" />

      <ContentControl Content="{Binding Focus}"

                      HorizontalContentAlignment="Stretch"

                      VerticalContentAlignment="Stretch"

                      Visibility="{Binding IsCompactOverlay, Converter={StaticResource BoolToVis}}" />

    </Grid>

  </Grid>

</Window>

