<UserControl x:Class="Jetset.App.Views.CompactOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Jetset.App.Helpers"
             x:Name="Root">
  <UserControl.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <helpers:IntEqualsConverter x:Key="IntEquals" />
  </UserControl.Resources>

  <Border Background="{DynamicResource WindowBackgroundBrush}"
          Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right"
                  Content="Capture"
                  Command="{Binding QuickCaptureCommand}"
                  Style="{DynamicResource SecondaryButton}"
                  Margin="8,0,0,0" />
          <TextBox x:Name="QuickCaptureTextBox"
                   Text="{Binding QuickCaptureTitle, UpdateSourceTrigger=PropertyChanged}"
                   Padding="6"
                   VerticalAlignment="Center"
                   ToolTip="Quick capture to Inbox (Ctrl+Shift+C)" />
        </DockPanel>

        <TextBlock Text="{Binding CurrentTime}"
                   FontFamily="{DynamicResource DisplayFont}"
                   FontSize="28"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding CompactLine}"
                   Margin="0,8,0,0"
                   FontSize="14"
                   FontFamily="{DynamicResource MonospaceFont}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

        <StackPanel Orientation="Horizontal"
                    Margin="0,12,0,0"
                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
          <Button Content="Pause"
                  Command="{Binding PauseCommand}"
                  Style="{DynamicResource SecondaryButton}"
                  Margin="0,0,8,0"
                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
          <Button Content="Resume"
                  Command="{Binding ResumeCommand}"
                  Style="{DynamicResource PrimaryButton}"
                  Margin="0,0,8,0"
                  Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
          <Button Content="Finish"
                  Command="{Binding FinishCommand}"
                  Style="{DynamicResource SecondaryButton}" />
        </StackPanel>

        <Button Content="{Binding StartWorkButtonText}"
                Command="{Binding StartWorkCommand}"
                Style="{DynamicResource PrimaryButton}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Visibility="{Binding ShowStartPanel, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

        <Border Margin="0,12,0,0"
                Padding="12"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Visibility="{Binding ShowStartPanel, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Start work"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,8" />
            <TextBlock Text="Task"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding StartSession.AvailableTasks}"
                      SelectedValue="{Binding StartSession.SelectedTaskId}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="Title"
                      Margin="0,4,0,10"
                      Padding="4" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton Content="Stopwatch"
                           IsChecked="{Binding StartSession.IsStopwatch}"
                           Margin="0,0,16,0"
                           GroupName="OverlayMode" />
              <RadioButton Content="Countdown"
                           IsChecked="{Binding StartSession.IsCountdown}"
                           GroupName="OverlayMode" />
            </StackPanel>

            <StackPanel Visibility="{Binding StartSession.IsCountdown, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Duration"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,0,0,6" />
              <WrapPanel>
                <RadioButton Content="5m" GroupName="OverlayPreset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.SelectedPresetMinutes, Converter={StaticResource IntEquals}, ConverterParameter=5}" />
                <RadioButton Content="15m" GroupName="OverlayPreset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.SelectedPresetMinutes, Converter={StaticResource IntEquals}, ConverterParameter=15}" />
                <RadioButton Content="25m" GroupName="OverlayPreset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.SelectedPresetMinutes, Converter={StaticResource IntEquals}, ConverterParameter=25}" />
                <RadioButton Content="45m" GroupName="OverlayPreset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.SelectedPresetMinutes, Converter={StaticResource IntEquals}, ConverterParameter=45}" />
                <RadioButton Content="60m" GroupName="OverlayPreset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.SelectedPresetMinutes, Converter={StaticResource IntEquals}, ConverterParameter=60}" />
                <RadioButton Content="Custom" GroupName="OverlayPreset" Margin="0,0,8,6"
                             IsChecked="{Binding StartSession.UseCustomDuration}" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal"
                          Visibility="{Binding StartSession.UseCustomDuration, Converter={StaticResource BoolToVis}}">
                <TextBox Width="64"
                         Padding="6"
                         Text="{Binding StartSession.CustomMinutes, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Start"
                      Command="{Binding ConfirmStartCommand}"
                      Style="{DynamicResource PrimaryButton}"
                      Margin="0,0,8,0" />
              <Button Content="Cancel"
                      Command="{Binding CancelStartCommand}"
                      Style="{DynamicResource SecondaryButton}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Button Content="Back to workspace"
                Command="{Binding ToggleCompactCommand}"
                Style="{DynamicResource LinkButton}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0" />

        <TextBlock Text="{Binding ValidationMessage}"
                   Foreground="{DynamicResource DangerBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
