<UserControl x:Class="Jetset.App.Views.ContextPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Jetset.App.Helpers">
  <UserControl.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <UserControl.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Convert to project"
                Command="{Binding ConvertToProjectCommand}"
                Visibility="{Binding CanConvertToProject, Converter={StaticResource BoolToVis}}" />
      <MenuItem Header="Convert to task"
                Command="{Binding ConvertToTaskCommand}"
                Visibility="{Binding CanConvertToTask, Converter={StaticResource BoolToVis}}" />
    </ContextMenu>
  </UserControl.ContextMenu>

  <Border Padding="16"
          Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1,0,0,0"
          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Context Panel"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,12" />

        <TextBlock Text="{Binding ProjectName}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <StackPanel Margin="0,0,0,12"
                    Visibility="{Binding HasDeadline, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Deadline"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding DeadlineText}"
                     FontWeight="SemiBold"
                     Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="Spent"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding SpentText}"
                     FontWeight="SemiBold"
                     Margin="0,2,0,0" />
          <TextBlock Text="(rollup)"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12"
                    Visibility="{Binding HasEstimate, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Estimate"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding EstimateText}"
                     FontWeight="SemiBold"
                     Margin="0,2,0,0" />
          <TextBlock Text="(rollup)"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <TextBlock Text="{Binding EffortSummaryText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,12"
                   Visibility="{Binding HasEstimate, Converter={StaticResource BoolToVis}}" />

        <Border Padding="8"
                Margin="0,0,0,12"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Deadline"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,4" />
            <CheckBox Content="Set deadline"
                      IsChecked="{Binding HasDeadline}" />
            <DatePicker SelectedDate="{Binding DeadlineDate}"
                        Margin="0,4,0,0"
                        IsEnabled="{Binding HasDeadline}"
                        Visibility="{Binding HasDeadline, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Border>

        <TextBlock Text="Context"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBlock Text="Project working notes. Edits save automatically and are independent of tasks."
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Text="{Binding ContextText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="160"
                 VerticalScrollBarVisibility="Auto"
                 Padding="6"
                 Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal">
          <Button Content="Convert to project"
                  Command="{Binding ConvertToProjectCommand}"
                  Style="{DynamicResource SecondaryButton}"
                  Margin="0,0,8,0"
                  Visibility="{Binding CanConvertToProject, Converter={StaticResource BoolToVis}}" />
          <Button Content="Convert to task"
                  Command="{Binding ConvertToTaskCommand}"
                  Style="{DynamicResource SecondaryButton}"
                  Visibility="{Binding CanConvertToTask, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
